PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/blogsphere?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CSRF_SECRET=replace-with-another-random-secret
FRONTEND_URL=http://localhost:5173
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Optional shared cookie domain, e.g. .example.com
# COOKIE_DOMAIN=.example.com
COOKIE_MAX_AGE_MS=604800000
JSON_BODY_LIMIT=1mb
SEED_USER_PASSWORD=replace-with-a-unique-16-plus-character-dev-password
# Set only for an intentionally destructive local seed run:
ALLOW_DESTRUCTIVE_SEED=false
# For a cross-site production frontend, set COOKIE_SAME_SITE=none (requires HTTPS).
